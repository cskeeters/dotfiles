{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // "opencode-websearch-cited@1.2.0",
    // "opencode-ralph-loop"
  ],
  // "formatter": false,
  // "lsp": false,
  "mcp": {
      "context7": {
          "type": "remote",
          "url": "https://mcp.context7.com/mcp",
          "headers": {
              "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
          },
          "enabled": true
      }
      // , "markdownify": {
          // "type": "local",
          // "command": ["node", "/Users/chad/src/markdownify-mcp/dist/index.js"],
          // // has to run ahead of time: source /Users/chad/src/markdownify-mcp/.venv/bin/activate
          // // or have this setting
          // "env": {
              // "UV_PATH": "/Users/chad/src/markdownify-mcp"
          // }
      // }
  },
  "provider": {
    "Strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hyde (Strata)",
      "options": {
        "baseURL": "http://192.168.20.11:8080/v1",
        "timeout": 60000000
      },
      "models": {
        "qwen3.8:27b-mtp-bf16": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
            },
          },
        },
      },
    },
    "hyde": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hyde (Ollama)",
      "options": {
        "baseURL": "http://192.168.20.11:11434/v1",
        "timeout": 60000000
      },
      "models": {
        "qwen3.8:27b-mtp-bf16": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
            },
          },
        },
        // "qwen3.8:27b-mtp-q8_0": {
        //   "variants": {
        //     // "xhigh": {
        //       // "reasoningEffort": "xhigh",
        //       // // "textVerbosity": "low",
        //     // },
        //     "fast": {
        //       // "disabled": true,
        //       "reasoningEffort": "low",
        //     },
        //   },
        // },
        "gpt-oss:120b": {},
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        // "baseURL": "http://localhost:8888/v1",
        "timeout": 60000000,
      },
      "models": {
        "qwen3.8:27b-mlx": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
            },
          },
        },
        "qwen3.8:27b-mxfp8": {
          "variants": {
            "fast": {
              "reasoningEffort": "low"
            },
          },
        },
        "gpt-oss:20b": {},
      }
    },
  },
  "model": "hyde/qwen3.8:27b-mtp-bf16",
  "permission": {
    "websearch": "allow",
    "websearch_cited": "allow", // depending on the plugin's tool name
    "external_directory": {
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    }
  }
}
