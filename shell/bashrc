#!/bin/bash

[[ -f ~/.bash_prompt ]] && source ~/.bash_prompt
[[ -f ~/.bash_local ]] && source ~/.bash_local

exists() {
    command -v $1 >/dev/null 2>&1
}

DOTFILES=$(dirname $(dirname $(realpath ~/.bashrc)))

# Don't display ^C characters
stty -echoctl

#### Common Shell tools
umask 002

export LANG=en_US.UTF-8

# Turn on colors for ls
export CLICOLOR=1

export VISUAL='vi'
export EDITOR=$VISUAL

export HISTCONTROL=erasedups

# Less
export LESS="FRX"

if [[ $- == *i* ]]; then
    # Setup colors in case this is a terminal
    COLOR_SCRIPT=$DOTFILES/offline/base16-shell/scripts/base16-default-dark.sh
    if [[ -r "$COLOR_SCRIPT" ]]; then
        source "$COLOR_SCRIPT"
    fi
fi

# https://support.apple.com/en-us/HT208050
export BASH_SILENCE_DEPRECATION_WARNING=1

#### Personal Binaries
[[ -d ~/bin ]] && export PATH=~/bin:$PATH

# Homebrew/linuxbrew
if [[ -d /home/linuxbrew/ ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Homebrew (MacOS)
if [[ -d /opt/homebrew ]]; then
    export BREW_PREFIX=/opt/homebrew
    export PATH="$BREW_PREFIX/bin:$PATH"
    export PATH="$BREW_PREFIX/sbin:$PATH"
fi

if exists vim; then
    export VISUAL='vim'
    export EDITOR=$VISUAL
    alias vi='vim'
fi

if exists nvim; then
    export VISUAL='nvim'
    export EDITOR=$VISUAL
    alias vi='nvim'
    alias vim='nvim'
fi

load_all()
{
    if [[ -d "$1" ]]; then
        #-r  raw input - disables interpretion of backslash escapes and line-continuation in the read data
        #-d  <DELIM>   - recognize <DELIM> as data-end, rather than <newline>
        while IFS= read -r -d $'\0' FILE; do
            if [[ -r $FILE ]]; then
                # echo "Sourcing $FILE"
                . "$FILE"
            fi
        done < <(find $1 -type f -print0)
    fi
}

# Load OS specific configuration
load_all "$DOTFILES/shell/bashrc.d-$(uname)"
# Load host specific configuration
# load_all "$DOTFILES/shell/bashrc.d-$(hostname -s)"

BCST_HOSTNAME_RE="ams.*mil$"
# if [[ -f /etc/sysconfig/bcst_log_config.yaml ]]; then
if [[ $(hostname) =~ $BCST_HOSTNAME_RE ]]; then
    load_all "$DOTFILES/shell/bashrc.d-bcst"
fi


# Aliases
alias cd..='cd ..'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

alias l='ls -lh --color=auto'
alias la='ls -lAh --color=auto'
alias ll='ls -lh --color=auto'
alias lm='ls -lhtr --color=auto'

alias grep="grep --color --exclude-dir=.hg --exclude-dir=.git"
alias fgrep="grep -F --color --exclude-dir=.hg --exclude-dir=.git"
alias egrep="grep -E --color --exclude-dir=.hg --exclude-dir=.git"

#### env.d

if [ -d "$HOME/.config/env.d" ]; then
    for f in "$HOME/.config/env.d/"*; do
        # Load the file and export variables
        # Using 'set -a' exports all variables defined until 'set +a'
        set -a
        source "$f"
        set +a
    done
fi

#### ls

# See defaults with `dircolors`

# Make other write (ow) more visible
LS_COLORS='ow=1;30;42';

export LS_COLORS

#### eza

if exists eza; then
    alias  l='eza -lg'
    alias la='eza -lag'
    alias ll='eza -lg'
    alias lm='eza -lg -s modified'
fi

#### lsd

if exists lsd; then
    alias ll=`lsd -l`

    alias  l='lsd -l'
    alias ll='lsd -l'
    alias la='lsd -la'
    alias lm='lsd -lhtr'
fi

#### neovim

# export NVIM_APPNAME=nvim_min

#### fd

if exists fdfind; then
    # Debian installs as fdfind
    alias fd=fdfind
fi

#### Lazygit

if exists lazygit; then
    alias lg=lazygit
fi


#### Asciidoc
# export XML_CATALOG_FILES=/usr/local/etc/xml/catalog

#### FZF

if [[ $- == *i* ]]; then
    if exists fzf; then
        if [[ -f ~/.fzf.sh ]]; then
            source ~/.fzf.sh
        fi
    fi
fi

#### Command Line Snippets

if [[ $- == *i* ]]; then
    # cmdsnip requires fzf
    if exists fzf; then
        if [[ -f ~/.cmdsnip.sh ]]; then
            export CMDSNIP_LOG_LEVEL=6
            source ~/.cmdsnip.sh

            bind -x '"\C-x\C-j": select_run_snippet'
            bind -x '"\C-x\C-k": rerun_snipet'
        fi
    else
        echo "cmdsnip will not load because fzf is not installed"
    fi
fi

#### dua

if exists git; then
    duaf() {
        local dir
        dir=$(command dua i)
        if [ -n "$dir" ] && [ -d "$dir" ]; then
            cd "$dir" || exit
        fi
    }
fi


#### bat
# May need to run `bat cache --build` to make theme visible

export BAT_THEME=kanagawa

#### neomutt

export ESCDELAY=50
if exists neomutt; then
    alias m='ACCT="yahoo" neomutt'
fi

#### mise

if exists mise; then
    eval "$(mise activate bash)"
fi

#### Override edit-and-execute-command

# Custom function to edit command and return it to the prompt
_edit_and_return_command() {
    local tmpfile=$(mktemp /tmp/bash_edit.XXXXXX)
    # Fill the temp file with the current line
    echo "$READLINE_LINE" > "$tmpfile"
    # Open editor
    ${EDITOR:-vim} "$tmpfile"
    # Read the file back into the readline buffer
    READLINE_LINE=$(cat "$tmpfile")
    # Move cursor to the end
    READLINE_POINT=${#READLINE_LINE}
    rm "$tmpfile"
}

if [[ $- == *i* ]]; then
    # Bind it to a shortcut (e.g., Ctrl-x Ctrl-v)
    bind -x '"\C-x\C-e": _edit_and_return_command'
fi

# Load custom user completions
if [[ -d ~/.config/bash_completion.d ]]; then
    for bc in ~/.config/bash_completion.d/*; do
        [[ -r "$bc" ]] && source "$bc"
    done
fi

