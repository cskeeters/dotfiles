snippet is_odd Is Page Odd?
	#counter(page).update(1)
	#context {
		// Page number resets don't change this
		if calc.odd(here().page()) {
			[odd]
		}
	}

### HEADER/FOOTER

snippet header Header (frontback)
	#set page(
		numbering: "1",

		header: context {
			if not frontback or calc.odd(here().page()) {
				align(right, {
					text(features: ("c2sc", "smcp"), title)
					h(1mm)
					[$|$]
					h(1mm)
					counter(page).display("1")
				})
			} else { // even
				align(left, {
					counter(page).display("1")
					h(1mm)
					[$|$]
					h(1mm)
					text(features: ("c2sc", "smcp"), title)
				})
			}
		},

		footer: context {
			set text(1em, style: "italic")
			align(center)[#counter(page).display()]
		},
	)

snippet is_page_level1_heading Chapter (Heading Level 1) Start Page?
	let current-headings = query(heading.where(level: 1)).filter(h => h.location().page() == here().page())
	if current-headings.len() == 0 {

snippet chapter_details Chapter (Heading Level 1) Details
	let current-heading = headings.last()
	let chapter_num = counter(heading).display(at: current-heading.location())
	let chapter_text = current-heading.body

snippet page_number Page Number
	#counter(page).display

