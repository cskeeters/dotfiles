## BASIC SYNTAX

snippet include Include directive
	#include "${1:file}.typ"

snippet for_range For Range
	for i in range(0, 255) {
		par[#i: ]
	}

snippet template Template (generic typst example)
	#let ${1:i}(it) = {
		it
	}

snippet show Show rule
	#show ${1:element}: it => {
		it
	}

snippet acronym Acronym (Custom)
	*${1:text}*: _${2:description}_\

snippet terms Terms (Definitions)
	// https://typst.app/docs/reference/model/terms/
	#set terms(separator: [: ])
	#set terms(separator: [ -- ])
	#set terms(separator: [ \ ])

	/ Term: description


