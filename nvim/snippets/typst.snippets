## HEADING STYLING

snippet heading Heading Styling
	// Numbering
	#set heading(numbering: "1.1")

	// Text to prepend to reference numbering (@intro)
	#show heading.where(level:1): set heading(supplement: "Chapter")
	#show heading.where(level:2): set heading(supplement: "Section")
	#show heading.where(level:3): set heading(supplement: "Subsection")


	// Font Styling Per Level
	#show heading.where(level:1): it => { text(weight: 800, it) }
	#show heading.where(level:2): it => { text(weight: 600, style: "italic", it) }
	#show heading.where(level:3): it => { text(weight: 600, it) }

	// Set Page break Before Heading.  This has to be last
	#show heading.where(level:1): it => { pagebreak(to: "odd", weak: true); it }



	#import "@local/format-headings:0.1.0": *
	// Set Heading Spacing
	#show: format_headings_spacing

	// Set Heading Underline
	#show heading.where(level:1): it => heading_underline(it)
	// #show heading.where(level:2): it => heading_underline(it)
	// #show heading.where(level:3): it => heading_underline(it)


snippet heading_show Headings Show Rules
	// Simpler
	//#show heading.where(level:1): it => block(
	//  above:1.3em,
	//  below:.8em,
	//  {
	//    //set text(size: 18pt)
	//    if (it.numbering != none) {
	//      counter(heading).display()
	//      h(6pt)
	//    }
	//    smallcaps(it.body)
	//  }
	//)

	// Set Heading Fonts
	#show heading: it => {
		// https://beautifulwebtype.com/vollkorn/
		set text(font: "Vollkorn", number-width: "proportional", features: ("pnum", "lnum"))
		it
	}

	#show heading: it => {
		// Defaults
		let above = 1em
		let below = .7em
		let style = "normal"

		if (it.level == 1) {
			above = 1.3em
			below = .8em
		} else if (it.level == 2) {
			above = 1.3em
			below = .8em
			style = "italic"
		}

		set text(style:style)

		block(
			above: above, below: below,
			{
				it
			}
		)
	}

snippet toc Table of Contents
	#heading("Table of Contents", outlined: false, bookmarked:true)
	#outline(title: none, indent:auto)

### TOC STYLING

snippet toc_styling Table of Contents -- Styling
	// This allows for outline formatting without the outrageous package
	// set outline.entry(fill: repeat([.~~])) // Optional
	// set outline.entry(fill: repeat([\_]))  // Optional
	#show outline.entry: it => link(
		it.element.location(),

		if (it.level == 1) {
			v(4pt)
			// it.indented(it.prefix(), text(rcc_red, weight:700, it.inner()))
			it.indented(it.prefix(), text(black, weight:700, it.inner()))
		} else {
			it.indented(it.prefix(), it.inner())
		}
	)

