## PACKAGES

### PACKAGE afigloss

snippet setup-glossaries Glossaries for Typst (glossarium)
	// See https://github.com/typst/packages/tree/main/packages/preview/glossarium/0.4.1
	#import "afigloss.typ": make-glossary, print-glossary, gls, glspl
	#show: make-glossary // Required to be just below import

	// Put at the end
	#generate-glossaries(acronyms:acronyms)

snippet gls afigloss: Reference glossary entry (or use @TERM)
	#gls("${1:SPP}")

snippet glsl afigloss: Reference glossary entry (long)
	#gls("${1:SPP}", long=true)

snippet glspl afigloss: Reference glossary entry (plurl)
	#glspl("${1:SPP}")

### PACKAGE in-dexter
snippet index in-dexter: Index
	#import "@preview/in-dexter:0.7.0": *

	// The word in index is not emitted
	Ethernet #index[Ethernet]

	#pagebreak()
	// Use a separate heading to control outlined AND bookmarked
	#heading("Index", outlined: false, bookmarked:true)
	#columns(2)[
	#make-index(
		use-bang-grouping: false,
		sort-order: upper,
	)
	]

### PACKAGE glossaries
snippet glossaries glossarium: Glossaries/Acronyms
	#import "@preview/glossarium:0.4.1": make-glossary, print-glossary, gls, glspl
	#show: make-glossary // Required just below import

	#pagebreak(weak: true)
	#print-glossary(
		disable-back-references: false,
		(
			(
				key: "ISSM",
				short: "ISSM",
				long: "Information System Security Manager",
				group: "Acronyms",
			),
			(
				key: "oidc",
				short: "OIDC",
				long: "OpenID Connect",
				desc: [OpenID is an open standard and decentralized authentication protocol promoted by the non-profit
				#link("https://en.wikipedia.org/wiki/OpenID#OpenID_Foundation")[OpenID Foundation].],
				group: "Acronyms",
			),
		)
	)

