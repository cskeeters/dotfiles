snippet main_doc Template for doc
	#import "@local/doc:0.1.0": *

	#let title = "Test Document"
	#let hardcopy = true

	#let metadata = (
		title: "",
		project: "",
		contractor_url: "",
		contractor: "",
		address: [
		],
		contract: "",
		task_order: "",
		keywords: "",
	)

	// Set PDF properties https://typst.app/docs/reference/model/document/
	#set document(
		title: metadata.title,
		author: metadata.contractor,
		keywords: metadata.keywords,
	)

	#set page(
		paper: "us-letter",
		margin: (y:1in, x:1in),
	)

	#show: make-glossary // Required just below import.  Enables @TERM syntax via show ref:
	//#show: glossary-autoref

	#show: setup.with(hardcopy: hardcopy)

	#show: colored_links

	// Q: Should this move into the body with shortcodes of some sort?
	#titlepage(metadata:metadata)

	#show: frontmatter.with(hardcopy:hardcopy)

	#show: toc.with(hardcopy:hardcopy)

	#show: mainmatter.with(metadata:metadata, hardcopy:hardcopy)

	#set heading(numbering: "1.", supplement: [Section])

	#titlepage(metadata:metadata)

	#set page(
		numbering: "1",

		header: context {
			if not hardcopy or calc.odd(here().page()) {
				align(center, {
					text(features: ("c2sc", "smcp"), title)
				})
			} else { // even
				align(center, {
					text(features: ("c2sc", "smcp"), title)
				})
			}
		},
	)

	= Introduction <introduction>
	#lorem(60)

	#pagebreak(weak: true)
	= Chapter One <chapter-one>
	#lorem(60)

snippet main_sfnet Template: RCH sfnet
	#import "@local/contract-util:0.2.0": *
	#import "@local/rch:0.1.0": *
	#import "@local/sfnet:0.1.0": *

	#let title = ""
	#let subtitle = ""
	#let footer_title = ""

	#set document(
	title: title,
	author: "Red Cedar Harmonia",
	keywords: "",
	)

	#show: frontmatter.with(logo:none)

	#Cover(
	logo: rch_logo(width:100pt),
	title: title,
	subtitle: subtitle,
	company: [
		*Red Cedar Harmonia* \
		161 Fort Evans Rd NE, Suite 200 \
		Leesburg, VA-20176 \

		#link("mailto:contact@redcedarconsultancy.com")[contact\@redcedarconsultancy.com] \
		TEL: +1 703 214 2778 \
		UEI: W8H3LZS24EB3
	]
	)

	#TOC()

	#show: mainmatter.with(title:title, footer_title:footer_title)

	#include "ch1.typ"
	#include "ch2.typ"
	#include "ch3.typ"
	#include "ch4.typ"


